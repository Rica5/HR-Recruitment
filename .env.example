# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# URL publique de l'app (utilisée pour les callbacks n8n et les liens email)
BASE_URL=https://votre-domaine.com

# ── Base de données ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/solumada_recruitment?retryWrites=true&w=majority

# ── Auth JWT ──────────────────────────────────────────────────────────────────
# Minimum 32 caractères, générer avec : openssl rand -hex 32
JWT_SECRET=remplacez_par_une_cle_secrete_aleatoire_de_32_caracteres_minimum

# ── Email ─────────────────────────────────────────────────────────────────────
# Les emails sont envoyés via l'API mailer.solumada.mg — aucune config SMTP requise.

# ── Uploads ───────────────────────────────────────────────────────────────────
# Laisser vide = ./uploads (relatif), ou chemin absolu sur le Droplet :
# UPLOAD_DIR=/var/lib/solumada/uploads

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://votre-instance.app.n8n.cloud
N8N_API_KEY=votre_cle_api_n8n

# Webhooks
N8N_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/candidature-reception
N8N_WF2_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/candidature-app
N8N_QUALIF_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/candidature-mailing
N8N_BATCH_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/batch-evaluation
N8N_BATCH_CV_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/batch-cv-extraction

# ID workflow n8n (optionnel)
N8N_WF2_ID=votre_workflow_id

# Secret partagé app ↔ n8n pour les callbacks
# Minimum 32 caractères : openssl rand -hex 32
N8N_CALLBACK_SECRET=remplacez_par_un_secret_partage_aleatoire_32_caracteres_min

# Retry config (optionnel)
N8N_MAX_RETRIES=3
N8N_RETRY_DELAY=4000

# ── Cal.com ───────────────────────────────────────────────────────────────────
CALCOM_API_KEY=cal_live_votre_cle_api_calcom

# ── CORS (optionnel — par défaut = BASE_URL) ──────────────────────────────────
# Plusieurs origines séparées par virgule :
# ALLOWED_ORIGINS=https://domaine1.com,https://domaine2.com
