    {
      "parameters": {
        "jsCode": "const wh     = $('01 - Webhook Candidature').item.json;\nconst email  = wh.candidat_email.toLowerCase();\nconst url    = wh.base_url + '/api/public/candidature/' + wh.candidature_id + '/rdv-confirme';\nconst secret = wh.callback_secret;\n\nlet bookings = [];\ntry {\n  const d16 = $('16 - Vérifier Cal.com 2').item.json;\n  bookings = d16?.data?.bookings || d16?.bookings || [];\n} catch(e) {}\nif (!bookings.length) {\n  try {\n    const d11 = $('11 - Vérifier Cal.com').item.json;\n    bookings = d11?.data?.bookings || d11?.bookings || [];\n  } catch(e) {}\n}\n\nconst booking = bookings.find(b =>\n  (b.attendees || []).some(a => a.email?.toLowerCase() === email)\n);\n\nlet date = null, heure = '', lieu = '';\nif (booking) {\n  const start = new Date(booking.startTime || booking.start);\n  date  = start.toISOString();\n  heure = start.toISOString().slice(11, 16);\n  lieu  = booking.location || '';\n}\n\nreturn [{ json: { url, secret, date, heure, lieu } }];"
      },
