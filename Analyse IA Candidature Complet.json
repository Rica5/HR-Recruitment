    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = (item.content && item.content[0] && item.content[0].text) ? item.content[0].text : '';\n// Supprimer le bloc markdown ```json ... ``` si présent\nconst match = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/);\nconst jsonStr = match ? match[1].trim() : raw.trim();\nlet analyse;\ntry {\n  analyse = JSON.parse(jsonStr);\n} catch(e) {\n  throw new Error('Impossible de parser la réponse Claude : ' + e.message + ' — Réponse brute : ' + raw.slice(0, 200));\n}\nreturn [{ json: { ...item, analyse } }];"
      },
