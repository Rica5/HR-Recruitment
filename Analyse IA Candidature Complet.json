      "parameters": {
        "jsCode": "const parsed  = $('05 - Parser réponse Claude').item.json;\nconst email   = parsed.candidat_email.toLowerCase();\nconst url     = parsed.callback_url + '/' + parsed.candidature_id + '/rdv-confirme';\nconst secret  = parsed.callback_secret;\n\nlet bookings = [];\ntry {\n  bookings = $('16 - Vérifier Cal.com 2').item.json?.data?.bookings || [];\n} catch(e) {}\nif (!bookings.length) {\n  try {\n    bookings = $('11 - Vérifier Cal.com').item.json?.data?.bookings || [];\n  } catch(e) {}\n}\n\nconst booking = bookings.find(b =>\n  (b.attendees || []).some(a => a.email?.toLowerCase() === email)\n);\n\nlet date = null, heure = '', lieu = '';\nif (booking) {\n  const start = new Date(booking.startTime || booking.start);\n  date  = start.toISOString();\n  heure = start.toISOString().slice(11, 16);\n  lieu  = booking.location || '';\n}\n\nreturn [{ json: { url, secret, date, heure, lieu } }];"
