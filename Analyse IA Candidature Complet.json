    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn [{ json: {\n  candidat_nom:         body.candidat_nom,\n  candidat_email:       body.candidat_email,\n  candidat_telephone:   body.candidat_telephone || '',\n  offre_id:             body.offre_id,\n  titre_poste:          body.titre_poste,\n  description_poste:    body.description_poste || '',\n  competences_requises: body.competences_requises || '',\n  annees_experience:    body.annees_experience || '',\n  langues_requises:     body.langues_requises || '',\n  exigences_ia:         body.exigences_ia || '',\n  type_contrat:         body.type_contrat || '',\n  localisation:         body.localisation || '',\n  email_recruteur:      body.email_recruteur,\n  cv_base64:            body.cv_base64 || '',\n  cv_mimetype:          body.cv_mimetype || 'application/pdf',\n  lettre_base64:        body.lettre_base64 || '',\n  lettre_mimetype:      body.lettre_mimetype || 'application/pdf',\n  date_candidature:     body.date_candidature || new Date().toISOString(),\n  candidature_id:       body.candidature_id || '',\n  callback_url:         body.callback_url || '',\n  test_requis:          body.test_requis === true || body.test_requis === 'true',\n  automatisation_active:body.automatisation_active === true || body.automatisation_active === 'true',\n  lien_calendar:        body.lien_calendar || '',\n  callback_secret:      body.callback_secret || ''\n}}];"
      },
      "id": "1ec33866-f671-4654-bd0b-a12a4529067b",
      "name": "02 - Extraire données",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        15648,
        9648
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst prompt = 'Tu es un expert RH. Analyse le CV et la lettre ci-joints.\\n\\n'\n  + '=== FICHE DE POSTE ===\\n'\n  + 'Titre: ' + d.titre_poste + '\\n'\n  + 'Missions: ' + d.description_poste + '\\n'\n  + 'Profil souhaitée: ' + d.profil_souhaite + '\\n'\n  + 'Competences: ' + d.competences_requises + '\\n'\n  + 'Experience: ' + (d.annees_experience || 'Non specifie') + '\\n'\n  + 'Langues: ' + (d.langues_requises || 'Non specifie') + '\\n'\n  + 'Contrat: ' + d.type_contrat + '\\n'\n  + 'Lieu: ' + d.localisation + '\\n'\n  + (d.exigences_ia ? '\\n=== EXIGENCES PRIORITAIRES ===\\n' + d.exigences_ia + '\\n' : '')\n  + '\\nRepondre UNIQUEMENT en JSON valide:\\n'\n  + '{\"score\":7,\"competences_detectees\":[\"X\"],\"competences_manquantes\":[\"Y\"],\"experience_annees\":3,\"niveau_education\":\"Licence\",\"adequation_poste\":\"Bon profil.\",\"points_forts\":\"Experience pertinente.\",\"points_faibles\":\"Peu de management.\",\"resume_analyse\":\"Candidat interessant.\",\"recommandation\":\"QUALIFIE\"}\\n'\n  + 'Score>=7=QUALIFIE, 4-6=A_REVOIR, <4=NON_SELECTIONNE\\n'\n  + 'IMPORTANT: Reponds UNIQUEMENT avec le JSON brut. Pas de bloc markdown, pas de backticks, pas de texte avant ou apres.';\nconst content = [];\nif (d.cv_base64) {\n  if ((d.cv_mimetype||'').includes('pdf'))\n    content.push({type:'document',source:{type:'base64',media_type:'application/pdf',data:d.cv_base64}});\n  else\n    content.push({type:'text',text:'=== CV ===\\n'+Buffer.from(d.cv_base64,'base64').toString('utf-8')});\n}\nif (d.lettre_base64) {\n  if ((d.lettre_mimetype||'').includes('pdf'))\n    content.push({type:'document',source:{type:'base64',media_type:'application/pdf',data:d.lettre_base64}});\n  else\n    content.push({type:'text',text:'=== Lettre ===\\n'+Buffer.from(d.lettre_base64,'base64').toString('utf-8')});\n}\ncontent.push({type:'text',text:prompt});\nreturn [{json:{...d, requestBody:{model:'claude-sonnet-4-6',max_tokens:2048,messages:[{role:'user',content}]}}}];"
      },
